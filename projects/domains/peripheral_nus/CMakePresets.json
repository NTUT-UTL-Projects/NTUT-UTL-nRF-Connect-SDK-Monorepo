{
    "version": 2,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20
    },
    "configurePresets": [
        {
            "name": "build_demo",
            "displayName": "Build Demo for nRF52840 DK nRF52840",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "BOARD": "nrf52840dk/nrf52840",
                "CONF_FILE": "prj.conf;demo/prj.conf",
                "DEBUG_THREAD_INFO": true,
                "CONFIG_DEBUG_OPTIMIZATIONS": true,
                "CONFIG_DEBUG_THREAD_INFO": true,
                "peripheral_nus_DEBUG_THREAD_INFO": true
            }
        }
    ]
}